# Resend API key used by /api/contact (server-only, never exposed to the client)
RESEND_API_KEY=

# Address that receives every contact-form submission
CONTACT_TO_EMAIL=

# Verified sender address used for outgoing emails
CONTACT_FROM_EMAIL=

# Visitor confirmation email feature flag.
# Unset / anything other than the exact string "true" = OFF (v1 default).
# Resend's sandbox sender cannot deliver to arbitrary visitor addresses until
# a custom domain is verified, so this stays OFF until that domain is ready.
CONTACT_CONFIRMATION_ENABLED=false

# Canonical absolute site URL used for SEO/OG tags (build-time, public)
VITE_SITE_URL=
